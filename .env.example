# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.
#
# IMPORTANT: always wrap values in single quotes, e.g. VAR='value'.
# This file is sourced by bash (never by Make's own `-include`, which
# treats `#` as a comment character anywhere on a line). Single-quoting
# protects secrets that contain #, $, *, or other shell-special characters.

# registry.redhat.io credentials (used only to PULL the ubi10/ubi and
# ubi10/ubi-micro base images at build time — never baked into the image)
REDHAT_REGISTRY_USERNAME=''
REDHAT_REGISTRY_PASSWORD=''

# quay.io credentials (used only to PUSH the built image).
# Prefer a quay.io robot account token scoped to this one repo over your
# personal quay.io password.
QUAY_USERNAME=''
QUAY_PASSWORD=''

# Google Cloud / Vertex AI config — injected at `podman run` time only.
# The Containerfile/image never hardcodes a project ID or region.
GCP_PROJECT_ID='itpc-ca-1d64055f2c'
GCP_REGION='global'

# IMAGE_NAME is the full, pullable reference (registry/namespace/repo).
# Build tags the image directly under this name, so `make push` needs no
# separate retag step, and any x86_64 podman host can run `bin/claude`
# straight against quay.io with no local build and no repo clone required.
IMAGE_NAME='quay.io/myee/claude-container'
IMAGE_TAG='latest'

# Path on the HOST to your Google Application Default Credentials file.
# Defaults to the standard gcloud ADC location if left blank.
ADC_HOST_PATH=''
