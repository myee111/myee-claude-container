# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.
#
# This is the RUN-ONLY env file — it has no registry.redhat.io credentials,
# because this client bundle never builds anything, only pulls and runs the
# already-published image.
#
# IMPORTANT: always wrap values in single quotes, e.g. VAR='value'.
# Single-quoting protects secrets containing #, $, *, etc. from being
# mangled when this file is sourced by bash.

# quay.io credentials to PULL the private image. A read-only robot account
# is preferable here over the write-capable one used for publishing, if you
# want to hand this bundle to other people/hosts.
QUAY_USERNAME=''
QUAY_PASSWORD=''

# The image to run. Must match what was published, and MUST be fully
# qualified with a registry host (e.g. quay.io/...). A bare name like
# 'claude-container' with no registry makes podman silently guess one
# from unqualified-search-registries and fail against the wrong one.
IMAGE_NAME='quay.io/your-namespace/claude-container'
IMAGE_TAG='latest'

# Google Cloud / Vertex AI config — injected at `podman run` time only,
# nothing project-specific is baked into the image itself.
GCP_PROJECT_ID='your-gcp-project-id'
GCP_REGION='global'

# Path on THIS host to your Google Application Default Credentials file.
# Leave blank to use the default gcloud ADC location. Set up with:
#   gcloud auth application-default login
ADC_HOST_PATH=''
