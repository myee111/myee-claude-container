#!/usr/bin/env bash
# Log podman into quay.io using this client bundle's .env credentials.
# Run this once per host (podman remembers the login in its auth file)
# before the first `claude` invocation, since quay.io/myee/claude-container
# is private.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLIENT_DIR="$(dirname "$SCRIPT_DIR")"

if [[ ! -f "$CLIENT_DIR/.env" ]]; then
  echo "login-quay: Missing $CLIENT_DIR/.env. Copy .env.example to .env and fill it in first." >&2
  exit 1
fi

set -a
# shellcheck disable=SC1091
source "$CLIENT_DIR/.env"
set +a

if [[ -z "${QUAY_USERNAME:-}" || -z "${QUAY_PASSWORD:-}" ]]; then
  echo "login-quay: QUAY_USERNAME/QUAY_PASSWORD are not set in $CLIENT_DIR/.env." >&2
  exit 1
fi

echo "$QUAY_PASSWORD" | podman login quay.io -u "$QUAY_USERNAME" --password-stdin
