#!/usr/bin/env bash
# Host-side wrapper: makes `claude` feel like a native command.
#
# This is the RUN-ONLY half of the myee-claude-container project. This
# client/ folder is self-contained — copy it to any x86_64 podman host and
# it works with no repo clone, no build, and no other files needed.
#
# Mounts the CURRENT directory ($PWD) into the container as the workspace,
# mounts your Google Application Default Credentials read-only, and injects
# Vertex AI config from .env at runtime — nothing project-specific is baked
# into the image itself. podman auto-pulls the image from quay.io the first
# time it's needed.
set -euo pipefail

# Resolve the real path of this script, following symlinks. This matters
# because the documented setup symlinks this file onto $PATH (e.g.
# ~/.local/bin/claude) — plain `dirname "${BASH_SOURCE[0]}"` would resolve
# to the symlink's directory, not this script's real directory, and then
# fail to find .env right next to it. Portable across GNU (Linux) and BSD
# (macOS) readlink, unlike `readlink -f`.
resolve_script_dir() {
  local source="${BASH_SOURCE[0]}"
  while [ -h "$source" ]; do
    local dir
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ $source != /* ]] && source="$dir/$source"
  done
  cd -P "$(dirname "$source")" && pwd
}

SCRIPT_DIR="$(resolve_script_dir)"
CLIENT_DIR="$(dirname "$SCRIPT_DIR")"

if [[ -f "$CLIENT_DIR/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$CLIENT_DIR/.env"
  set +a
fi

IMAGE_NAME="${IMAGE_NAME:-quay.io/your-namespace/claude-container}"
IMAGE_TAG="${IMAGE_TAG:-latest}"
GCP_REGION="${GCP_REGION:-global}"
ADC_HOST_PATH="${ADC_HOST_PATH:-$HOME/.config/gcloud/application_default_credentials.json}"

# IMAGE_NAME must be fully qualified (registry/namespace/repo), e.g.
# quay.io/myee/claude-container. If it's just a bare repo name like
# "claude-container", podman treats it as an *unqualified* name and
# silently guesses a registry from /etc/containers/registries.conf's
# unqualified-search-registries list — which usually picks the wrong one
# (e.g. registry.access.redhat.com) and fails with a confusing "Repo not
# found" error instead of ever reaching quay.io. Fail fast instead.
registry_part="${IMAGE_NAME%%/*}"
if [[ "$IMAGE_NAME" != */* ]] || [[ "$registry_part" != *.* && "$registry_part" != *:* && "$registry_part" != "localhost" ]]; then
  echo "claude: IMAGE_NAME='$IMAGE_NAME' is not fully qualified." >&2
  echo "        Set it in $CLIENT_DIR/.env to include the registry host, e.g.:" >&2
  echo "          IMAGE_NAME='quay.io/myee/claude-container'" >&2
  echo "        A bare name like 'claude-container' makes podman silently guess" >&2
  echo "        a registry and usually fail against the wrong one." >&2
  exit 1
fi

if [[ -z "${GCP_PROJECT_ID:-}" ]]; then
  echo "claude: GCP_PROJECT_ID is not set. Create $CLIENT_DIR/.env from .env.example first." >&2
  exit 1
fi

if [[ ! -f "$ADC_HOST_PATH" ]]; then
  echo "claude: Google ADC file not found at $ADC_HOST_PATH." >&2
  echo "        Run 'gcloud auth application-default login' on the host, or set ADC_HOST_PATH in .env." >&2
  exit 1
fi

# Rootless podman remaps container UIDs to a host subuid range, so the
# container's non-root user (1001) can't read your ADC file's normal 0600
# permissions directly. Copy it to a private (mode 700) temp dir with 0644
# perms just for this run, then shred it on exit. Your real credentials
# file on disk is never modified.
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT
install -m 644 "$ADC_HOST_PATH" "$TMP_DIR/adc.json"

podman run --rm -it \
  -v "$TMP_DIR/adc.json:/home/claude/.config/gcloud/application_default_credentials.json:ro,Z" \
  -e CLAUDE_CODE_USE_VERTEX=1 \
  -e CLOUD_ML_REGION="$GCP_REGION" \
  -e ANTHROPIC_VERTEX_PROJECT_ID="$GCP_PROJECT_ID" \
  -e GOOGLE_APPLICATION_CREDENTIALS=/home/claude/.config/gcloud/application_default_credentials.json \
  -v "$PWD:/home/claude/workspace:Z" \
  -w /home/claude/workspace \
  "${IMAGE_NAME}:${IMAGE_TAG}" \
  claude "$@"
